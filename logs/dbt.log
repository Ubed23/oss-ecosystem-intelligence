    create  table
      "oss"."main"."fct_release_reliability__dbt_tmp"
  
    
    as (
      -- Post-release regression ratio: bugs opened in the N days after a release,
-- against what the prior 90 days' rate would predict.
--
-- Correlation, not causation: a big release draws attention, and attention
-- produces reports. Say so on the dashboard rather than implying the release
-- caused the bugs.
with releases as (

    select repo_id, tag_name, published_at
    from "oss"."main"."stg_releases"
    where published_at >= timestamp '2025-10-01'

),

bugs as (

    select repo_id, created_at
    from "oss"."main"."int_labeled_issues"
    where normalized_label in ('bug', 'regression')

),

windowed as (

    select
        rel.repo_id,
        rel.tag_name,
        rel.published_at,
        count(b.created_at) filter (
            where b.created_at >= rel.published_at
              and b.created_at <  rel.published_at + interval 14 day
        ) as bugs_after,
        count(b.created_at) filter (
            where b.created_at <  rel.published_at
              and b.created_at >= rel.published_at - interval 90 day
        ) as bugs_baseline
    from releases rel
    left join bugs b on rel.repo_id = b.repo_id
    group by 1, 2, 3

)

select
    *,
    bugs_baseline * 1.0
        * 14 / 90 as expected_bugs,
    bugs_after / nullif(
        bugs_baseline * 1.0
        * 14 / 90, 0
    ) as regression_ratio
from windowed
    );
    
  
