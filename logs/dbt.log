    s.scorecard_overall,
    s.check_maintained,
    s.check_code_review,
    s.scorecard_date,
    s.repo_id is not null as has_scorecard
from "oss"."main"."repos" r
left join "oss"."main"."stg_scorecard" s using (repo_id)
where r.repo_id is not null
    );
    
  
