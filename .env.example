

# GitHub personal access token (read-only public repo access is enough).
# Used by pull_github_graphql.py, pull_releases.py, resolve_repo_ids.py, check_archived.py.
GITHUB_TOKEN=

# Google Cloud project used for BigQuery (GH Archive history and the backtest only).
BQ_PROJECT=
# Safety cap: any single BigQuery query above this many GB is aborted.
BQ_MAX_GB_PER_RUN=60

# Publishing to Google Sheets (scripts/to_sheets.py).
# ID is the long string in the Sheet's URL between /d/ and /edit.
GSHEET_ID=
# Path to the service-account key. Share the Sheet with its client_email as Editor.
GOOGLE_APPLICATION_CREDENTIALS=service_account.json
