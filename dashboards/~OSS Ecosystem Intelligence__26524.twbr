            <column caption='Critical Repositories' datatype='integer' name='[Calculation_1822766785724418]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(&#13;&#10;    IF [health_tier] = &quot;critical&quot;&#13;&#10;    THEN [repo_id]&#13;&#10;    END&#13;&#10;)' />
            </column>
            <column caption='At Risk Repositories' datatype='integer' name='[Calculation_1822766786457603]' role='measure' type='quantitative'>
