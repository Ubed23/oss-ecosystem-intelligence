    <worksheet name='At risk Repositories'>
      <table>
        <view>
          <datasources>
            <datasource caption='repos+ (oss-intel-marts)' name='federated.14rv57519mnb5y18wf6fs0nw8qaz' />
          </datasources>
          <datasource-dependencies datasource='federated.14rv57519mnb5y18wf6fs0nw8qaz'>
            <column caption='At Risk Repositories' datatype='integer' name='[Calculation_1822766786457603]' role='measure' type='quantitative'>
