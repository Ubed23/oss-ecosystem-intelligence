    <worksheet name='Alert Feed'>
      <table>
        <view>
          <datasources>
            <datasource caption='repos+ (oss-intel-marts)' name='federated.14rv57519mnb5y18wf6fs0nw8qaz' />
          </datasources>
          <datasource-dependencies datasource='federated.14rv57519mnb5y18wf6fs0nw8qaz'>
            <column caption='Criticality Rank' datatype='integer' name='[Calculation_1822766820306958]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [criticality_tier] WHEN &quot;tier_1&quot; THEN 3 WHEN &quot;tier_2&quot; THEN 2 ELSE 1 END' />
              <aliases>
                <alias key='1' value='Tier 3 -  Replaceble' />
                <alias key='2' value='Tier 2 - Costly' />
                <alias key='3' value='Tier 1 - Foundational' />
              </aliases>
            </column>
            <column caption='Urgency ' datatype='real' name='[Calculation_1822766834679823]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_1822766820306958] * (100 - [health_score])' />
            </column>
            <column caption='Alert Reason' datatype='string' name='[Calculation_1822766938935334]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [bus_factor_50] = 1 AND [Calculation_1822766820306958] &gt;= 2&#13;&#10;    THEN &quot;Single maintainer on a critical dependency&quot;&#13;&#10;ELSEIF [days_since_release] &gt; 365 AND [Calculation_1822766820306958] &gt;= 2&#13;&#10;    THEN &quot;No release in over a year&quot;&#13;&#10;ELSEIF [unresponded_rate] &gt; 0.6&#13;&#10;    THEN &quot;More than 60% of issues unanswered&quot;&#13;&#10;ELSEIF [health_score] &lt; 30&#13;&#10;    THEN &quot;Health score in the bottom band&quot;&#13;&#10;END' />
            </column>
            <column-instance column='[Calculation_1822766834679823]' derivation='Avg' name='[avg:Calculation_1822766834679823:qk]' pivot='key' type='quantitative' />
            <column-instance column='[health_score]' derivation='Avg' name='[avg:health_score:qk]' pivot='key' type='quantitative' />
            <column caption='Bus Factor 50' datatype='integer' name='[bus_factor_50]' role='measure' type='quantitative' />
            <column caption='Criticality Tier' datatype='string' name='[criticality_tier]' role='dimension' type='nominal' />
            <column caption='Days Since Release' datatype='integer' name='[days_since_release]' role='measure' type='quantitative' />
            <column caption='Health Score' datatype='real' name='[health_score]' role='measure' type='quantitative' />
            <column-instance column='[Calculation_1822766938935334]' derivation='None' name='[none:Calculation_1822766938935334:nk]' pivot='key' type='nominal' />
            <column-instance column='[repo_full_name]' derivation='None' name='[none:repo_full_name:nk]' pivot='key' type='nominal' />
            <column caption='Repo Full Name' datatype='string' name='[repo_full_name]' role='dimension' type='nominal' />
            <column caption='Unresponded Rate' datatype='real' name='[unresponded_rate]' role='measure' type='quantitative' />
          </datasource-dependencies>
          <filter class='categorical' column='[federated.14rv57519mnb5y18wf6fs0nw8qaz].[none:Calculation_1822766938935334:nk]'>
            <groupfilter function='union' user:ui-domain='database' user:ui-enumeration='inclusive' user:ui-marker='enumerate'>
              <groupfilter function='member' level='[none:Calculation_1822766938935334:nk]' member='&quot;More than 60\% of issues unanswered&quot;' />
              <groupfilter function='member' level='[none:Calculation_1822766938935334:nk]' member='&quot;Single maintainer on a critical dependency&quot;' />
            </groupfilter>
          </filter>
          <computed-sort column='[federated.14rv57519mnb5y18wf6fs0nw8qaz].[none:repo_full_name:nk]' direction='DESC' using='[federated.14rv57519mnb5y18wf6fs0nw8qaz].[avg:Calculation_1822766834679823:qk]' />
          <slices>
            <column>[federated.14rv57519mnb5y18wf6fs0nw8qaz].[none:Calculation_1822766938935334:nk]</column>
          </slices>
          <aggregation value='true' />
        </view>
        <style>
          <style-rule element='cell'>
            <format attr='width' value='98' />
          </style-rule>
          <style-rule element='header'>
            <format attr='width' field='[federated.14rv57519mnb5y18wf6fs0nw8qaz].[none:Calculation_1822766938935334:nk]' value='272' />
