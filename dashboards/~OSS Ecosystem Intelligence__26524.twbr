    <worksheet name='Retention Curve by Tier'>
      <table>
        <view>
          <datasources>
            <datasource caption='repos+ (oss-intel-marts)' name='federated.14rv57519mnb5y18wf6fs0nw8qaz' />
          </datasources>
          <datasource-dependencies datasource='federated.14rv57519mnb5y18wf6fs0nw8qaz'>
            <column caption='Retention Weighted' datatype='real' name='[Calculation_1822769925759087]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([retained_contributors])/SUM([cohort_contributors])' />
            </column>
            <column caption='Cohort Contributors' datatype='integer' name='[cohort_contributors]' role='measure' type='quantitative' />
            <column caption='Criticality Tier' datatype='string' name='[criticality_tier]' role='dimension' type='nominal' />
