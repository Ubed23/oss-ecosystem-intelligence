      </column>
      <column caption='At Risk Repositories' datatype='integer' name='[Calculation_1822766786457603]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(&#13;&#10;IF [health_tier]=&quot;at_risk&quot;&#13;&#10;THEN [repo_id]&#13;&#10;END&#13;&#10;)' />
      </column>
      <column caption='Healthy Repositories' datatype='integer' name='[Calculation_1822766788722692]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(&#13;&#10;IF [health_tier] IN (&quot;stable&quot;,&quot;healthy&quot;)&#13;&#10;THEN [repo_id]&#13;&#10;END&#13;&#10;)' />
      </column>
      <column caption='Risk repository %' datatype='real' name='[Calculation_1822766789308421]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(&#13;&#10;    IF [health_tier] IN (&quot;critical&quot;, &quot;at_risk&quot;)&#13;&#10;    THEN [repo_id]&#13;&#10;    END&#13;&#10;)&#13;&#10;/&#13;&#10;COUNTD([repo_id])' />
      </column>
      <column caption='Sort - Health Tier' datatype='integer' name='[Calculation_1822766790914054]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [health_tier]&#13;&#10;&#13;&#10;WHEN &quot;critical&quot; THEN 1&#13;&#10;WHEN &quot;at_risk&quot; THEN 2&#13;&#10;WHEN &quot;stable&quot; THEN 3&#13;&#10;WHEN &quot;healthy&quot; THEN 4&#13;&#10;&#13;&#10;END' />
      </column>
      <column caption='Selected KPI' datatype='real' name='[Calculation_1822766791811080]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 1822766791135239]&#13;&#10;&#13;&#10;WHEN &quot;Health Score&quot;&#13;&#10;THEN AVG([health_score])&#13;&#10;&#13;&#10;WHEN &quot;Bus Factor&quot;&#13;&#10;THEN AVG([bus_factor_50])&#13;&#10;&#13;&#10;WHEN &quot;Response Time&quot;&#13;&#10;THEN AVG([ttfr_p50_hours])&#13;&#10;&#13;&#10;WHEN &quot;Unresponded Rate&quot;&#13;&#10;THEN AVG([unresponded_rate])&#13;&#10;&#13;&#10;WHEN &quot;Bug Backlog&quot;&#13;&#10;THEN AVG([bugs_open_at_month_end])&#13;&#10;&#13;&#10;WHEN &quot;Contributor Retention&quot;&#13;&#10;THEN AVG([retention_m3])&#13;&#10;&#13;&#10;WHEN &quot;Release Gap&quot;&#13;&#10;THEN AVG([median_release_gap_days])&#13;&#10;&#13;&#10;END' />
      </column>
      <column caption='Dynamic Risk Status' datatype='string' name='[Calculation_1822766792720396]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [health_score] &lt; [Parameters].[Parameter 1822766792388619]&#13;&#10;THEN &quot;Below Threshold&quot;&#13;&#10;ELSE &quot;Above Threshold&quot;&#13;&#10;END' />
      </column>
      <column caption='Health Score Range' datatype='string' name='[Calculation_1822766804693005]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='STR(INT(FLOOR([health_score] / 10) * 10))&#13;&#10;+&#13;&#10;&quot;–&quot;&#13;&#10;+&#13;&#10;STR(INT(FLOOR([health_score] / 10) * 10 + 10))' />
      </column>
      <column caption='Criticality Rank' datatype='integer' name='[Calculation_1822766820306958]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [criticality_tier] WHEN &quot;tier_1&quot; THEN 3 WHEN &quot;tier_2&quot; THEN 2 ELSE 1 END' />
        <aliases>
          <alias key='1' value='Tier 3 -  Replaceble' />
          <alias key='2' value='Tier 2 - Costly' />
          <alias key='3' value='Tier 1 - Foundational' />
        </aliases>
      </column>
      <column caption='Urgency ' datatype='real' name='[Calculation_1822766834679823]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_1822766820306958] * (100 - [health_score])' />
      </column>
      <column caption='Rank Group' datatype='string' name='[Calculation_1822766835073040]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF RANK_UNIQUE(AVG([health_score]), &apos;desc&apos;) &lt;= [Parameters].[Parameter 1822766837596178]&#13;&#10;    THEN &quot;1 · Healthiest&quot;&#13;&#10;ELSEIF RANK_UNIQUE(AVG([health_score]), &apos;desc&apos;) &gt; [Calculation_1822766837948435] - [Parameters].[Parameter 1822766837596178]&#13;&#10;    THEN &quot;2 · Lowest health&quot;&#13;&#10;END'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Calculation1' datatype='string' name='[Calculation_1822766836989969]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [bus_factor_50] = 1 AND [days_since_release] &gt; 365&#13;&#10;    THEN &quot;Frozen — one maintainer, no release in a year&quot;&#13;&#10;ELSEIF [unresponded_rate] &gt; 0.8&#13;&#10;    THEN &quot;Issue tracker effectively unmonitored&quot;&#13;&#10;ELSEIF [bus_factor_50] = 1&#13;&#10;    THEN &quot;Single point of failure — one person merges half the work&quot;&#13;&#10;ELSEIF [unresponded_rate] &gt; 0.5 AND [ttfr_p50_hours] &gt; 240&#13;&#10;    THEN &quot;Slow and selective — most issues go unanswered&quot;&#13;&#10;ELSEIF [days_since_release] &gt; 365&#13;&#10;    THEN &quot;No release in over a year&quot;&#13;&#10;ELSEIF [health_score] &lt; 30&#13;&#10;    THEN &quot;Weak across several signals&quot;&#13;&#10;ELSEIF [bus_factor_50] &gt;= 4 AND [unresponded_rate] &lt; 0.3 AND [ttfr_p50_hours] &lt; 72&#13;&#10;    THEN &quot;Exemplary — distributed, responsive, actively released&quot;&#13;&#10;ELSEIF [bus_factor_50] &gt;= 4 AND [unresponded_rate] &lt; 0.4&#13;&#10;    THEN &quot;Well distributed and reasonably responsive&quot;&#13;&#10;ELSEIF [ttfr_p50_hours] &lt; 24 AND [unresponded_rate] &lt; 0.4&#13;&#10;    THEN &quot;Fast to respond&quot;&#13;&#10;ELSEIF [bus_factor_50] &gt;= 3&#13;&#10;    THEN &quot;Maintenance load shared across several people&quot;&#13;&#10;ELSE &quot;Steady — no strong signals either way&quot;&#13;&#10;END' />
      </column>
      <column caption='Repo Count In View' datatype='integer' name='[Calculation_1822766837948435]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SIZE()'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Block Header' datatype='string' name='[Calculation_1822766838702100]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_1822766835073040] = &quot;1 · Healthiest&quot;&#13;&#10;    THEN &quot;Top &quot; + STR([Parameters].[Parameter 1822766837596178]) + &quot; — healthiest&quot;&#13;&#10;ELSEIF [Calculation_1822766835073040] = &quot;2 · Lowest health&quot;&#13;&#10;    THEN &quot;Bottom &quot; + STR([Parameters].[Parameter 1822766837596178]) + &quot; — lowest health&quot;&#13;&#10;END'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='C_Score' datatype='integer' name='[Calculation_1822766869659669]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [health_score] &lt; 30 THEN 3 ELSEIF [health_score] &lt; 45 THEN 2 ELSE 1 END' />
      </column>
      <column caption='C_Bus' datatype='integer' name='[Calculation_1822766869848086]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [bus_factor_50] = 1 THEN 3 ELSEIF [bus_factor_50] &lt;= 2 THEN 2 ELSE 1 END' />
      </column>
      <column caption='C_Response' datatype='integer' name='[Calculation_1822766870007831]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [ttfr_p50_hours] &gt; 240 THEN 3 ELSEIF [ttfr_p50_hours] &gt; 72 THEN 2 ELSE 1 END' />
      </column>
      <column caption='C_Unanswered' datatype='integer' name='[Calculation_1822766870073368]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [unresponded_rate] &gt; 0.6 THEN 3 ELSEIF [unresponded_rate] &gt; 0.35 THEN 2 ELSE 1 END' />
      </column>
      <column caption='C_Release' datatype='integer' name='[Calculation_1822766870183961]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [days_since_release] &gt; 365 THEN 3 ELSEIF [days_since_release] &gt; 120 THEN 2 ELSE 1 END' />
      </column>
      <column caption='Red Flags' datatype='integer' name='[Calculation_1822766872363034]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Calculation_1822766869659669]=3 THEN 1 ELSE 0 END&#13;&#10;+ IF [Calculation_1822766869848086]=3 THEN 1 ELSE 0 END&#13;&#10;+ IF [Calculation_1822766870007831]=3 THEN 1 ELSE 0 END&#13;&#10;+ IF [Calculation_1822766870073368]=3 THEN 1 ELSE 0 END&#13;&#10;+ IF [Calculation_1822766870183961]=3 THEN 1 ELSE 0 END' />
      </column>
      <column caption='Verdict' datatype='string' name='[Calculation_1822766895366172]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [bus_factor_50] = 1 AND [days_since_release] &gt; 365&#13;&#10;    THEN &quot;Frozen: one maintainer, no release in a year&quot;&#13;&#10;ELSEIF [unresponded_rate] &gt; 0.8&#13;&#10;    THEN &quot;Issue tracker effectively unmonitored&quot;&#13;&#10;ELSEIF [bus_factor_50] = 1&#13;&#10;    THEN &quot;Single point of failure: one person merges half the work&quot;&#13;&#10;ELSEIF [unresponded_rate] &gt; 0.5 AND [ttfr_p50_hours] &gt; 240&#13;&#10;    THEN &quot;Slow and selective: most issues go unanswered&quot;&#13;&#10;ELSEIF [days_since_release] &gt; 365&#13;&#10;    THEN &quot;No release in over a year&quot;&#13;&#10;ELSEIF [health_score] &lt; 30&#13;&#10;    THEN &quot;Weak across several signals&quot;&#13;&#10;ELSEIF [bus_factor_50] &gt;= 4 AND [unresponded_rate] &lt; 0.3 AND [ttfr_p50_hours] &lt; 72&#13;&#10;    THEN &quot;Exemplary: distributed, responsive, actively released&quot;&#13;&#10;ELSEIF [bus_factor_50] &gt;= 4 AND [unresponded_rate] &lt; 0.4&#13;&#10;    THEN &quot;Well distributed and reasonably responsive&quot;&#13;&#10;ELSEIF [ttfr_p50_hours] &lt; 24 AND [unresponded_rate] &lt; 0.4&#13;&#10;    THEN &quot;Fast to respond&quot;&#13;&#10;ELSEIF [bus_factor_50] &gt;= 3&#13;&#10;    THEN &quot;Maintenance load shared across several people&quot;&#13;&#10;ELSE &quot;Steady: no strong signals either way&quot;&#13;&#10;END' />
      </column>
      <column caption='Month Date' datatype='date' name='[Calculation_1822766929166365]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATE([month_start (health!score!monthly)])' />
      </column>
      <column caption='Latest Month' datatype='date' name='[Calculation_1822766929240094]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='{ FIXED : MAX([Calculation_1822766929166365]) }' />
      </column>
      <column caption='Score Latest' datatype='real' name='[Calculation_1822766929330207]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG(IF [Calculation_1822766929166365] = [Calculation_1822766929240094] THEN [health_score (health!score!monthly)] END)' />
      </column>
      <column caption='Score Previous' datatype='real' name='[Calculation_1822766929477664]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG(IF [Calculation_1822766929166365] = DATEADD(&apos;month&apos;, -1, [Calculation_1822766929240094]) THEN [health_score (health!score!monthly)] END)' />
      </column>
      <column caption='Score Change Pts' datatype='real' name='[Calculation_1822766929657889]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_1822766929330207] - [Calculation_1822766929477664]' />
      </column>
      <column caption='Score Change Pct' datatype='real' name='[Calculation_1822766929784866]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Calculation_1822766929477664] &gt; 0 THEN ([Calculation_1822766929330207] - [Calculation_1822766929477664]) / [Calculation_1822766929477664] END' />
      </column>
      <column caption='KPI Delta Label' datatype='string' name='[Calculation_1822766929920035]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF ISNULL([Calculation_1822766929657889]) THEN &quot;no prior month&quot;&#13;&#10;ELSEIF ABS([Calculation_1822766929657889]) &lt; 2&#13;&#10;    THEN &quot;● &quot; + IF [Calculation_1822766929657889] &gt; 0 THEN &quot;+&quot; ELSE &quot;&quot; END&#13;&#10;         + STR(ROUND([Calculation_1822766929657889], 1))&#13;&#10;ELSEIF [Calculation_1822766929657889] &gt; 0&#13;&#10;    THEN &quot;▲ +&quot; + STR(ROUND([Calculation_1822766929657889], 1)) + &quot;(&quot;&#13;&#10;         + STR(ROUND(ZN([Calculation_1822766929784866]) * 100, 1)) + &quot;%)&quot;&#13;&#10;ELSE &quot;▼ &quot; + STR(ROUND([Calculation_1822766929657889], 1)) + &quot;(&quot;&#13;&#10;         + STR(ROUND(ZN([Calculation_1822766929784866]) * 100, 1)) + &quot;%)&quot;&#13;&#10;END' />
      </column>
      <column caption='Delta Direction' datatype='string' name='[Calculation_1822766934011940]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF ABS([Calculation_1822766929657889]) &lt; 2 THEN &quot;flat&quot;&#13;&#10;   ELSEIF [Calculation_1822766929657889] &gt; 0 THEN &quot;up&quot;&#13;&#10;   ELSE &quot;down&quot;&#13;&#10;   END' />
      </column>
      <column caption='Alert Reason' datatype='string' name='[Calculation_1822766938935334]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [bus_factor_50] = 1 AND [Calculation_1822766820306958] &gt;= 2&#13;&#10;    THEN &quot;Single maintainer on a critical dependency&quot;&#13;&#10;ELSEIF [days_since_release] &gt; 365 AND [Calculation_1822766820306958] &gt;= 2&#13;&#10;    THEN &quot;No release in over a year&quot;&#13;&#10;ELSEIF [unresponded_rate] &gt; 0.6&#13;&#10;    THEN &quot;More than 60% of issues unanswered&quot;&#13;&#10;ELSEIF [health_score] &lt; 30&#13;&#10;    THEN &quot;Health score in the bottom band&quot;&#13;&#10;END' />
      </column>
      <column caption='Avg Health Score Colour' datatype='string' name='[Calculation_1822767458324519]' role='measure' type='nominal'>
        <calculation class='tableau' formula='If [Calculation_1822766782902273] &gt; 50 THEN &quot;Green&quot;&#13;&#10;ELSE &quot;RED&quot;&#13;&#10;END' />
      </column>
      <column caption='W Bus' datatype='real' name='[Calculation_1822767487537201]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 1822767485149224]&#13;&#10;  WHEN &quot;Balanced&quot; THEN 0.20&#13;&#10;  WHEN &quot;Reliability-heavy&quot; THEN 0.15&#13;&#10;  WHEN &quot;Community-heavy&quot; THEN 0.30&#13;&#10;  ELSE [Parameters].[Parameter 1822767486079018]&#13;&#10;END' />
      </column>
      <column caption='W Activity' datatype='real' name='[Calculation_1822767487803442]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 1822767485149224]&#13;&#10;  WHEN &quot;Balanced&quot; THEN 0.15&#13;&#10;  WHEN &quot;Reliability-heavy&quot; THEN 0.10&#13;&#10;  WHEN &quot;Community-heavy&quot; THEN 0.25&#13;&#10;  ELSE [Parameters].[Parameter 1822767486664748]&#13;&#10;END' />
      </column>
      <column caption='W Response' datatype='real' name='[Calculation_1822767487938611]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 1822767485149224]&#13;&#10;  WHEN &quot;Balanced&quot; THEN 0.20&#13;&#10;  WHEN &quot;Reliability-heavy&quot; THEN 0.30&#13;&#10;  WHEN &quot;Community-heavy&quot; THEN 0.10&#13;&#10;  ELSE [Parameters].[Parameter 1822767486844973]&#13;&#10;END' />
      </column>
      <column caption='W Unanswered' datatype='real' name='[Calculation_1822767488376884]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 1822767485149224]&#13;&#10;  WHEN &quot;Balanced&quot; THEN 0.15&#13;&#10;  WHEN &quot;Reliability-heavy&quot; THEN 0.20&#13;&#10;  WHEN &quot;Community-heavy&quot; THEN 0.10&#13;&#10;  ELSE [Parameters].[Parameter 1822767486992430]&#13;&#10;END' />
      </column>
      <column caption='W Backlog' datatype='real' name='[Calculation_1822767488462901]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 1822767485149224]&#13;&#10;  WHEN &quot;Balanced&quot; THEN 0.15&#13;&#10;  WHEN &quot;Reliability-heavy&quot; THEN 0.20&#13;&#10;  WHEN &quot;Community-heavy&quot; THEN 0.05&#13;&#10;  ELSE [Parameters].[Parameter 1822767487152175]&#13;&#10;END' />
      </column>
      <column caption='W Retention' datatype='real' name='[Calculation_1822767488540726]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 1822767485149224]&#13;&#10;  WHEN &quot;Balanced&quot; THEN 0.15&#13;&#10;  WHEN &quot;Reliability-heavy&quot; THEN 0.05&#13;&#10;  WHEN &quot;Community-heavy&quot; THEN 0.20&#13;&#10;  ELSE [Parameters].[Parameter 1822767487279152]&#13;&#10;END' />
      </column>
      <column caption='Adjustable Health Score' datatype='real' name='[Calculation_1822767489638455]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='100 * (&#13;&#10;  [Calculation_1822767487537201]        * [bus_factor_score]&#13;&#10;+ [Calculation_1822767487803442]   * [maintainer_activity_score]&#13;&#10;+ [Calculation_1822767487938611]   * [response_time_score]&#13;&#10;+ [Calculation_1822767488376884] * [unresponded_score]&#13;&#10;+ [Calculation_1822767488462901]    * [bug_backlog_score]&#13;&#10;+ [Calculation_1822767488540726]  * [contributor_retention_score]&#13;&#10;) / ([Calculation_1822767487537201] + [Calculation_1822767487803442] + [Calculation_1822767487938611] + [Calculation_1822767488376884] + [Calculation_1822767488462901] + [Calculation_1822767488540726])' />
      </column>
      <column caption='Weight Total' datatype='real' name='[Calculation_1822767501684802]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_1822767487537201] + [Calculation_1822767487803442] + [Calculation_1822767487938611] + [Calculation_1822767488376884] + [Calculation_1822767488462901] + [Calculation_1822767488540726]' />
      </column>
      <column caption='Share Bus' datatype='real' name='[Calculation_1822767502131267]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_1822767487537201] / [Calculation_1822767501684802]' />
      </column>
      <column caption='Share Activity' datatype='real' name='[Calculation_1822767502250052]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_1822767487803442] / [Calculation_1822767501684802]' />
      </column>
      <column caption='Share Response' datatype='real' name='[Calculation_1822767502323781]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_1822767487938611] / [Calculation_1822767501684802]' />
      </column>
      <column caption='Share Unanswered' datatype='real' name='[Calculation_1822767502438470]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_1822767488376884] / [Calculation_1822767501684802]' />
      </column>
      <column caption='Share Backlog' datatype='real' name='[Calculation_1822767502540871]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_1822767488462901] / [Calculation_1822767501684802]' />
      </column>
      <column caption='Share Retention' datatype='real' name='[Calculation_1822767502602312]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_1822767488540726] / [Calculation_1822767501684802]' />
      </column>
      <column caption='Repo Label' datatype='string' name='[Calculation_1822767514968137]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[repo_full_name] + &quot;   &quot; + STR(ROUND([Calculation_1822767489638455], 1))' />
      </column>
      <column caption='MIN(0)' datatype='integer' name='[Calculation_1822767522451531]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='MIN(0)' />
      </column>
      <column caption='Min(0)' datatype='integer' name='[Calculation_1822767522566221]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='Min(0)' />
      </column>
      <column caption='Balanced Score' datatype='real' name='[Calculation_1822767525666894]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='100 * ( 0.20*[bus_factor_score] + 0.15*[maintainer_activity_score]&#13;&#10;      + 0.20*[response_time_score] + 0.15*[unresponded_score]&#13;&#10;      + 0.15*[bug_backlog_score] + 0.15*[contributor_retention_score] )' />
      </column>
      <column caption='Shift vs Balanced' datatype='real' name='[Calculation_1822767525765199]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_1822767489638455] - [Calculation_1822767525666894]' />
      </column>
      <column caption='Show Sliders' datatype='boolean' name='[Calculation_1822767533576272]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Parameters].[Parameter 1822767485149224] = &quot;Custom (use sliders)&quot;' />
      </column>
      <column caption='Hide Sliders' datatype='boolean' name='[Calculation_1822767533662289]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Parameters].[Parameter 1822767485149224] &lt;&gt; &quot;Custom (use sliders)&quot;' />
      </column>
      <column caption='Pts Bus' datatype='real' name='[Calculation_1822769629802579]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_1822767502131267]*[bus_factor_score]* 100' />
      </column>
      <column caption='Pts Activity' datatype='real' name='[Calculation_1822769629970516]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_1822767502250052]*[maintainer_activity_score]* 100' />
      </column>
      <column caption='Pts Response' datatype='real' name='[Calculation_1822769630142549]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_1822767502323781]*[response_time_score] * 100' />
      </column>
      <column caption='Pts Unanswered' datatype='real' name='[Calculation_1822769630302294]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_1822767502438470] * [unresponded_score] * 100' />
      </column>
      <column caption='Pts Backlog' datatype='real' name='[Calculation_1822769630535767]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_1822767502540871]* [bug_backlog_score]* 100' />
      </column>
      <column caption='Pts Retention' datatype='real' name='[Calculation_1822769630810200]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_1822767502602312]  * [contributor_retention_score]  * 100' />
      </column>
      <column caption='Show Risk' datatype='boolean' name='[Calculation_1822769711112282]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Parameters].[Parameter 1822769710825561] = &quot;Risk&quot;' />
      </column>
      <column caption='Show Operations' datatype='boolean' name='[Calculation_1822769711173723]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Parameters].[Parameter 1822769710825561] = &quot;Operations&quot;' />
      </column>
      <column caption='Show Community' datatype='boolean' name='[Calculation_1822769711325276]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Parameters].[Parameter 1822769710825561] = &quot;Community&quot;' />
      </column>
      <column caption='Show Issues' datatype='boolean' name='[Calculation_1822769711431773]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Parameters].[Parameter 1822769710825561] = &quot;Issues&quot;' />
      </column>
      <column caption='Share Bin' datatype='real' name='[Calculation_1822769715531871]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='FLOOR(ROUND([top_author_share]*100, 4) / 10) / 10' />
      </column>
      <column caption='Risk Rank' datatype='integer' name='[Calculation_1822769719926881]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='RANK(AVG([health_score]), &apos;asc&apos;)'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Show Risk Row' datatype='boolean' name='[Calculation_1822769720016994]' role='measure' type='nominal'>
        <calculation class='tableau' formula='[Calculation_1822769719926881] &lt;= [Parameters].[Parameter 1822769719783520]'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Worst Labels' datatype='string' name='[Calculation_1822769727021155]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF RANK(AVG([health_score]), &apos;asc&apos;) &lt;= 5 THEN ATTR([package_name]) END'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Share Band' datatype='string' name='[Calculation_1822769730867301]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='STR(FLOOR(ROUND([top_author_share]*100, 4) / 10) * 10) + &quot;–&quot; + STR(FLOOR(ROUND([top_author_share]*100, 4) / 10) * 10 + 10) + &quot;%&quot;' />
      </column>
      <column caption='Show Lowest' datatype='boolean' name='[Calculation_1822769740812392]' role='measure' type='nominal'>
        <calculation class='tableau' formula='[Calculation_1822769719926881] &lt;= [Parameters].[Parameter 1822769719783520]'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Dormant' datatype='integer' name='[Calculation_1822769745227882]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(INT([is_dormant]))' />
      </column>
      <column caption='Unresponded Share' datatype='real' name='[Calculation_1822769746980971]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([unresponded_rate] * [items_opened_90d]) / SUM([items_opened_90d])' />
      </column>
      <column caption='Unresponded Share Monthly' datatype='real' name='[Calculation_1822769754226797]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([unresponded_rate (health!monthly)] * [items_opened]) / SUM([items_opened])' />
      </column>
      <column caption='Complete month' datatype='boolean' name='[Calculation_1822769915736174]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[month_start]&lt;{ FIXED : MAX([month_start])}' />
      </column>
      <column caption='Retention Weighted' datatype='real' name='[Calculation_1822769925759087]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([retained_contributors])/SUM([cohort_contributors])' />
      </column>
      <column caption='New Contributors' datatype='integer' name='[Calculation_1822769926479984]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [months_since] = 0 THEN [cohort_contributors] END)' />
      </column>
      <column caption='Retention 3M' datatype='real' name='[Calculation_1822769926660209]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [months_since]=3 THEN [retained_contributors] END) /SUM(IF [months_since] =3 then&#13;&#10;[cohort_contributors] END)' />
      </column>
      <column caption='Active Contributions' datatype='real' name='[Calculation_1822769927176306]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([active_contributors (health!monthly)]) / COUNTD([month_start])' />
      </column>
      <column caption='New Contributors per Month' datatype='real' name='[Calculation_1822769928409203]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_1822769926479984] / COUNTD([cohort_month])' />
      </column>
      <column caption='Single Bus factor' datatype='integer' name='[Calculation_1822769930502260]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [bus_factor_50] = 1 THEN 1 ELSE 0 END)' />
      </column>
      <column caption='Is Latest Complete Month' datatype='boolean' name='[Calculation_1822769946828917]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[month_start] = DATEADD(&apos;month&apos;, -1, {FIXED : MAX([month_start])})' />
      </column>
      <column caption='Backlog Rank' datatype='integer' name='[Calculation_1822769947054198]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='RANK(SUM([bugs_open_at_month_end (health!monthly)]), &apos;desc&apos;)'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Show Backlog Row' datatype='boolean' name='[Calculation_1822769947185271]' role='measure' type='nominal'>
        <calculation class='tableau' formula='[Calculation_1822769947054198] &lt;= 10'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Repos in Ecosystem' datatype='integer' name='[Calculation_1822769965531256]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([repo_id (health!monthly)])' />
      </column>
      <column caption='Open Bugs per Repo' datatype='real' name='[Calculation_1822769965678713]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([bugs_open_at_month_end (health!monthly)]) / COUNTD([repo_id (health!monthly)])' />
      </column>
      <column aggregation='None' caption='Health Score (bin)' datatype='integer' name='[Health Score (bin)]' role='dimension' type='ordinal'>
        <calculation class='bin' decimals='1' formula='[health_score]' peg='0' size='10' />
      </column>
